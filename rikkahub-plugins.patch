+package me.rerere.rikkahub.plugin.api;
+
+/** Описание инструмента, который плагин предоставляет модели. */
+public final class PluginTool {
+    private final String name;
+    private final String description;
+    private final String parametersSchema;
+    private final boolean needsApproval;
+    private final PluginToolHandler handler;
+
+    /**
+     * @param name             имя инструмента: латиница, цифры, _ и -
+     * @param description      описание для модели
+     * @param parametersSchema JSON-схема параметров, например
+     *                         {"properties":{"city":{"type":"string"}},"required":["city"]}.
+     *                         null или пустая строка — без параметров.
+     * @param handler          обработчик вызова (выполняется в фоновом потоке)
+     */
+    public PluginTool(String name, String description, String parametersSchema, PluginToolHandler handler) {
+        this(name, description, parametersSchema, false, handler);
+    }
+
+    /** То же, но с флагом: требовать подтверждение пользователя перед вызовом. */
+    public PluginTool(String name, String description, String parametersSchema,
+                      boolean needsApproval, PluginToolHandler handler) {
+        this.name = name;
+        this.description = description;
+        this.parametersSchema = parametersSchema;
+        this.needsApproval = needsApproval;
+        this.handler = handler;
+    }
+
+    public String getName() { return name; }
+    public String getDescription() { return description; }
+    public String getParametersSchema() { return parametersSchema; }
+    public boolean getNeedsApproval() { return needsApproval; }
+    public PluginToolHandler getHandler() { return handler; }
+}
