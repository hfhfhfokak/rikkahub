+package com.example.hello;
+
+import android.content.Context;
+import android.os.BatteryManager;
+
+import org.json.JSONObject;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Random;
+
+import me.rerere.rikkahub.plugin.api.PluginContext;
+import me.rerere.rikkahub.plugin.api.PluginTool;
+import me.rerere.rikkahub.plugin.api.RikkaPlugin;
+
+/** Пример плагина: два инструмента для модели + дополнение к системному промпту. */
+public class HelloPlugin extends RikkaPlugin {
+    private PluginContext ctx;
+
+    @Override
+    public void onLoad(PluginContext context) {
+        this.ctx = context;
+        context.log("Hello plugin loaded, host version " + context.getHostVersionCode());
+    }
+
+    @Override
+    public List<PluginTool> getTools() {
+        PluginTool random = new PluginTool(
+                "random_number",
+                "Returns a random integer between min and max (inclusive).",
+                "{\"properties\":{\"min\":{\"type\":\"integer\"},\"max\":{\"type\":\"integer\"}},"
+                        + "\"required\":[\"min\",\"max\"]}",
+                args -> {
+                    JSONObject o = new JSONObject(args);
+                    int min = o.getInt("min");
+                    int max = o.getInt("max");
+                    return String.valueOf(min + new Random().nextInt(max - min + 1));
+                });
+
+        PluginTool battery = new PluginTool(
+                "battery_level",
+                "Returns the current battery level of the device in percent.",
+                null,
+                args -> {
+                    BatteryManager bm = (BatteryManager) ctx.getApplication()
+                            .getSystemService(Context.BATTERY_SERVICE);
+                    return bm.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY) + "%";
+                });
+
+        return Arrays.asList(random, battery);
+    }
+
+    @Override
+    public String getSystemPrompt() {
+        return "You can use the random_number and battery_level tools when the user asks for them.";
+    }
+}
