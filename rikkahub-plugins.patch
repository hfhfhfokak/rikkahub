@@ -0,0 +1,40 @@
+package me.rerere.rikkahub.plugin
+
+import me.rerere.ai.core.MessageRole
+import me.rerere.ai.ui.UIMessage
+import me.rerere.ai.ui.UIMessagePart
+import me.rerere.rikkahub.data.ai.transformers.InputMessageTransformer
+import me.rerere.rikkahub.data.ai.transformers.OutputMessageTransformer
+import me.rerere.rikkahub.data.ai.transformers.TransformerContext
+
+private fun UIMessage.mapText(block: (String) -> String): UIMessage = copy(
+    parts = parts.map { part ->
+        if (part is UIMessagePart.Text) {
+            val newText = block(part.text)
+            if (newText == part.text) part else part.copy(text = newText)
+        } else {
+            part
+        }
+    }
+)
+
+/** Прогоняет текст запроса через плагины перед отправкой модели. */
+class PluginInputTransformer(private val manager: PluginManager) : InputMessageTransformer {
+    override suspend fun transform(ctx: TransformerContext, messages: List<UIMessage>): List<UIMessage> {
+        if (!manager.hasActivePlugins()) return messages
+        return messages.map { msg ->
+            val role = msg.role.name.lowercase()
+            msg.mapText { manager.transformInput(role, it) }
+        }
+    }
+}
+
+/** Прогоняет готовый ответ модели через плагины. */
+class PluginOutputTransformer(private val manager: PluginManager) : OutputMessageTransformer {
+    override suspend fun transform(ctx: TransformerContext, messages: List<UIMessage>): List<UIMessage> {
+        if (!manager.hasActivePlugins()) return messages
+        return messages.map { msg ->
+            if (msg.role == MessageRole.ASSISTANT) msg.mapText { manager.transformOutput(it) } else msg
+        }
+    }
+}
