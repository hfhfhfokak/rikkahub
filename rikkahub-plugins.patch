+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import kotlinx.coroutines.launch
+import me.rerere.hugeicons.HugeIcons
+import me.rerere.hugeicons.stroke.Add01
+import me.rerere.hugeicons.stroke.Delete01
+import me.rerere.rikkahub.R
+import me.rerere.rikkahub.plugin.PluginInfo
+import me.rerere.rikkahub.plugin.PluginManager
+import me.rerere.rikkahub.ui.components.nav.BackButton
+import me.rerere.rikkahub.ui.context.LocalToaster
+import me.rerere.rikkahub.ui.theme.CustomColors
+import org.koin.compose.koinInject
+
+@Composable
+fun SettingPluginPage() {
+    val manager = koinInject<PluginManager>()
+    val plugins by manager.plugins.collectAsStateWithLifecycle()
+    val scope = rememberCoroutineScope()
+    val context = LocalContext.current
+    val toaster = LocalToaster.current
+    val scrollBehavior = TopAppBarDefaults.exitUntilCollapsedScrollBehavior()
+    val layoutDirection = LocalLayoutDirection.current
+
+    var pendingEnable by remember { mutableStateOf<PluginInfo?>(null) }
+    var pendingDelete by remember { mutableStateOf<PluginInfo?>(null) }
+
+    val filePicker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        uri ?: return@rememberLauncherForActivityResult
+        scope.launch {
+            manager.install(uri)
+                .onSuccess {
+                    toaster.show(context.getString(R.string.plugin_page_install_success, it.manifest.name))
+                }
+                .onFailure {
+                    toaster.show(
+                        context.getString(R.string.plugin_page_install_failed, it.message ?: it.javaClass.simpleName)
+                    )
+                }
+        }
+    }
+
+    Scaffold(
+        topBar = {
+            LargeFlexibleTopAppBar(
+                title = { Text(stringResource(R.string.setting_page_plugins)) },
+                navigationIcon = { BackButton() },
+                scrollBehavior = scrollBehavior,
+                colors = CustomColors.topBarColors,
+            )
+        },
+        floatingActionButton = {
+            FloatingActionButton(
+                onClick = {
+                    filePicker.launch(
+                        arrayOf("application/zip", "application/x-zip-compressed", "application/octet-stream")
+                    )
+                }
+            ) {
+                Icon(HugeIcons.Add01, contentDescription = stringResource(R.string.plugin_page_add))
+            }
+        },
+        modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+        containerColor = CustomColors.topBarColors.containerColor,
+    ) { innerPadding ->
+        Box(modifier = Modifier.fillMaxSize()) {
+            LazyColumn(
+                modifier = Modifier.fillMaxSize(),
+                verticalArrangement = Arrangement.spacedBy(8.dp),
+                contentPadding = PaddingValues(
+                    start = innerPadding.calculateStartPadding(layoutDirection) + 16.dp,
+                    top = innerPadding.calculateTopPadding() + 16.dp,
+                    end = innerPadding.calculateEndPadding(layoutDirection) + 16.dp,
+                    // место под FAB
+                    bottom = innerPadding.calculateBottomPadding() + 96.dp,
+                ),
+            ) {
+                items(plugins, key = { it.manifest.id }) { info ->
+                    PluginItem(
+                        info = info,
+                        onToggle = { enabled ->
+                            if (enabled) {
+                                pendingEnable = info
+                            } else {
+                                scope.launch { manager.setEnabled(info.manifest.id, false) }
+                            }
+                        },
+                        onDelete = { pendingDelete = info },
+                        modifier = Modifier.animateItem(),
+                    )
+                }
+            }
+
+            if (plugins.isEmpty()) {
+                Column(
+                    modifier = Modifier
+                        .align(Alignment.Center)
+                        .padding(32.dp),
+                    verticalArrangement = Arrangement.spacedBy(8.dp),
+                    horizontalAlignment = Alignment.CenterHorizontally,
+                ) {
+                    Text(text = stringResource(R.string.plugin_page_empty))
+                    Text(
+                        text = stringResource(R.string.plugin_page_empty_hint),
+                        style = MaterialTheme.typography.bodySmall,
+                    )
+                }
+            }
+        }
+    }
+
+    pendingEnable?.let { info ->
+        AlertDialog(
+            onDismissRequest = { pendingEnable = null },
+            title = { Text(stringResource(R.string.plugin_page_enable_title, info.manifest.name)) },
+            text = { Text(stringResource(R.string.plugin_page_enable_warning)) },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        pendingEnable = null
+                        scope.launch { manager.setEnabled(info.manifest.id, true) }
+                    }
+                ) { Text(stringResource(R.string.plugin_page_enable)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { pendingEnable = null }) { Text(stringResource(R.string.cancel)) }
+            },
+        )
+    }
+
+    pendingDelete?.let { info ->
+        AlertDialog(
+            onDismissRequest = { pendingDelete = null },
+            title = { Text(stringResource(R.string.plugin_page_delete_title, info.manifest.name)) },
+            text = { Text(stringResource(R.string.plugin_page_delete_text)) },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        pendingDelete = null
+                        scope.launch { manager.uninstall(info.manifest.id) }
+                    }
+                ) { Text(stringResource(R.string.delete)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { pendingDelete = null }) { Text(stringResource(R.string.cancel)) }
+            },
+        )
+    }
+}
+
+@Composable
+private fun PluginItem(
+    info: PluginInfo,
+    onToggle: (Boolean) -> Unit,
+    onDelete: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val manifest = info.manifest
+    Card(
+        modifier = modifier.fillMaxWidth(),
+        colors = CardDefaults.cardColors(containerColor = CustomColors.listItemColors.containerColor),
+    ) {
+        Column(
+            modifier = Modifier.padding(16.dp),
+            verticalArrangement = Arrangement.spacedBy(4.dp),
+        ) {
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                Column(modifier = Modifier.weight(1f)) {
+                    Text(text = manifest.name, style = MaterialTheme.typography.titleMedium)
+                    val meta = buildString {
+                        append("v").append(manifest.version)
+                        if (manifest.author.isNotBlank()) append(" · ").append(manifest.author)
+                    }
+                    Text(
+                        text = meta,
+                        style = MaterialTheme.typography.labelMedium,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+                Switch(checked = info.enabled, onCheckedChange = onToggle)
+                IconButton(onClick = onDelete) {
+                    Icon(HugeIcons.Delete01, contentDescription = stringResource(R.string.delete))
+                }
+            }
+            if (manifest.description.isNotBlank()) {
+                Text(text = manifest.description, style = MaterialTheme.typography.bodyMedium)
+            }
+            info.error?.let {
+                Text(
+                    text = stringResource(R.string.plugin_page_error, it),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.error,
+                )
+            }
+        }
+    }
+}
