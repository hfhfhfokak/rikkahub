@@ -0,0 +1,50 @@
+package me.rerere.rikkahub.plugin.api;
+
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Базовый класс плагина RikkaHub. Плагин (Java или Kotlin) наследует его и указывает
+ * полное имя своего класса в поле {@code mainClass} файла plugin.json.
+ *
+ * Класс должен иметь публичный конструктор без аргументов.
+ * Все методы необязательны для переопределения.
+ *
+ * Плагин выполняется в процессе приложения без песочницы: через {@link PluginContext}
+ * ему доступны Application, внутренние сервисы приложения (Koin), SharedPreferences и т.д.
+ */
+public abstract class RikkaPlugin {
+
+    /** Вызывается при включении плагина (и при запуске приложения, если плагин включён). */
+    public void onLoad(PluginContext context) throws Exception {
+    }
+
+    /** Вызывается при выключении или удалении плагина. Освободите ресурсы, остановите потоки. */
+    public void onUnload() {
+    }
+
+    /** Инструменты (tools), которые будут доступны модели во всех чатах. Вызывается при каждой генерации. */
+    public List<PluginTool> getTools() {
+        return Collections.emptyList();
+    }
+
+    /** Текст, который дописывается в конец системного промпта. null — ничего не добавлять. */
+    public String getSystemPrompt() {
+        return null;
+    }
+
+    /**
+     * Преобразование текста сообщения перед отправкой модели (меняет только запрос, не историю чата).
+     *
+     * @param role "system", "user", "assistant" или "tool"
+     * @return новый текст
+     */
+    public String transformInput(String role, String text) {
+        return text;
+    }
+
+    /** Преобразование готового текстового ответа модели (результат сохраняется в чате). */
+    public String transformOutput(String text) {
+        return text;
+    }
+}
