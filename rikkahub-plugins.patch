+package me.rerere.rikkahub.plugin.api;
+
+import android.app.Application;
+import android.content.SharedPreferences;
+
+import java.io.File;
+
+/** Доступ плагина к приложению. Создаётся приложением и передаётся в {@link RikkaPlugin#onLoad}. */
+public interface PluginContext {
+
+    /** Application приложения: через него доступны Context, ActivityLifecycleCallbacks, ресурсы и т.д. */
+    Application getApplication();
+
+    /** Идентификатор плагина из plugin.json. */
+    String getPluginId();
+
+    /**
+     * Папка плагина. Ресурсы из zip (кроме plugin.json и classes*.dex) лежат в подпапке "files",
+     * подпапка "data" — для записи ваших данных. Папка очищается при обновлении плагина (кроме SharedPreferences).
+     */
+    File getPluginDir();
+
+    /** Постоянные настройки плагина. */
+    SharedPreferences getPreferences();
+
+    /** versionCode приложения RikkaHub. */
+    int getHostVersionCode();
+
+    /**
+     * Получить внутренний сервис приложения из Koin по имени класса, например
+     * "me.rerere.rikkahub.data.datastore.SettingsStore". Возвращает null, если не найден.
+     * Классы приложения доступны плагину напрямую через рефлексию/ClassLoader.
+     */
+    Object getHostService(String className);
+
+    /** Выполнить код в главном потоке. */
+    void runOnMainThread(Runnable runnable);
+
+    /** Запись в logcat с тегом плагина. */
+    void log(String message);
+}
