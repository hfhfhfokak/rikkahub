+++ b/app/src/main/java/me/rerere/rikkahub/plugin/PluginManager.kt
@@ -0,0 +1,416 @@
+package me.rerere.rikkahub.plugin
+
+import android.app.Application
+import android.content.Context
+import android.content.SharedPreferences
+import android.net.Uri
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import dalvik.system.DexClassLoader
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import me.rerere.ai.core.InputSchema
+import me.rerere.ai.core.Tool
+import me.rerere.ai.ui.UIMessagePart
+import me.rerere.rikkahub.AppScope
+import me.rerere.rikkahub.BuildConfig
+import me.rerere.rikkahub.plugin.api.PluginContext
+import me.rerere.rikkahub.plugin.api.PluginTool
+import me.rerere.rikkahub.plugin.api.RikkaPlugin
+import org.koin.core.context.GlobalContext
+import java.io.File
+import java.util.UUID
+import java.util.concurrent.ConcurrentHashMap
+import java.util.zip.ZipEntry
+import java.util.zip.ZipFile
+import java.util.zip.ZipOutputStream
+
+private const val TAG = "PluginManager"
+private const val MAX_PLUGIN_BYTES = 256L * 1024 * 1024
+private val PLUGIN_ID_REGEX = Regex("^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$")
+private val DEX_NAME_REGEX = Regex("^classes\\d*\\.dex$")
+
+/** Содержимое plugin.json в корне zip-архива плагина. */
+@Serializable
+data class PluginManifest(
+    val id: String,
+    val name: String,
+    val version: String = "1.0",
+    val description: String = "",
+    val author: String = "",
+    /** Полное имя класса, унаследованного от [RikkaPlugin]. */
+    val mainClass: String,
+    /** Минимальный versionCode приложения. */
+    val minAppVersionCode: Int = 0,
+)
+
+data class PluginInfo(
+    val manifest: PluginManifest,
+    val enabled: Boolean,
+    val loaded: Boolean,
+    val error: String? = null,
+)
+
+@Serializable
+private data class PluginState(val enabled: List<String> = emptyList())
+
+private class LoadedPlugin(
+    val manifest: PluginManifest,
+    val plugin: RikkaPlugin,
+)
+
+/**
+ * Управляет плагинами: установка из .zip, включение/выключение, удаление и загрузка кода (DexClassLoader).
+ *
+ * Формат zip: plugin.json + classes.dex (можно classes2.dex ...) + любые ресурсы
+ * (+ lib/<abi>/*.so для нативных библиотек).
+ *
+ * ВНИМАНИЕ: плагин выполняется в процессе приложения с теми же правами и без песочницы.
+ */
+class PluginManager(
+    private val context: Context,
+    private val appScope: AppScope,
+) {
+    private val json = Json { ignoreUnknownKeys = true; prettyPrint = true }
+    private val root = File(context.filesDir, "plugins").apply { mkdirs() }
+    private val stateFile = File(root, "state.json")
+    private val loadingMarker = File(root, ".loading")
+    private val lock = Mutex()
+    private val loaded = ConcurrentHashMap<String, LoadedPlugin>()
+    private val errors = ConcurrentHashMap<String, String>()
+    private val ready = CompletableDeferred<Unit>()
+
+    private val _plugins = MutableStateFlow<List<PluginInfo>>(emptyList())
+    val plugins: StateFlow<List<PluginInfo>> = _plugins.asStateFlow()
+
+    init {
+        appScope.launch(Dispatchers.IO) {
+            try {
+                lock.withLock {
+                    recoverFromCrash()
+                    readState().forEach { id -> loadPluginSafely(id) }
+                    publish()
+                }
+            } catch (e: Throwable) {
+                Log.e(TAG, "init failed", e)
+            } finally {
+                ready.complete(Unit)
+            }
+        }
+    }
+
+    // ---------- публичный API ----------
+
+    suspend fun awaitReady() = ready.await()
+
+    /** Установить (или обновить) плагин из zip. Новый плагин устанавливается выключенным. */
+    suspend fun install(uri: Uri): Result<PluginInfo> = withContext(Dispatchers.IO) {
+        lock.withLock {
+            runCatching {
+                val tmp = File(root, ".tmp-${UUID.randomUUID()}")
+                try {
+                    val manifest = extractToTemp(uri, tmp)
+                    val target = File(root, manifest.id)
+                    val wasEnabled = manifest.id in readState()
+                    unloadPlugin(manifest.id)
+                    target.deleteRecursively()
+                    check(tmp.renameTo(target)) { "Cannot move plugin to ${target.path}" }
+                    File(target, "code.jar").setReadOnly()
+                    errors.remove(manifest.id)
+                    if (wasEnabled) loadPluginSafely(manifest.id)
+                    publish()
+                    _plugins.value.first { it.manifest.id == manifest.id }
+                } finally {
+                    tmp.deleteRecursively()
+                }
+            }
+        }
+    }
+
+    suspend fun setEnabled(id: String, enabled: Boolean) = withContext(Dispatchers.IO) {
+        lock.withLock {
+            val state = readState().toMutableSet()
+            if (enabled) {
+                state.add(id)
+                writeState(state)
+                loadPluginSafely(id)
+                // не удалось загрузить — оставляем выключенным, ошибка видна в списке
+                if (!loaded.containsKey(id)) {
+                    state.remove(id)
+                    writeState(state)
+                }
+            } else {
+                state.remove(id)
+                writeState(state)
+                unloadPlugin(id)
+                errors.remove(id)
+            }
+            publish()
+        }
+    }
+
+    suspend fun uninstall(id: String) = withContext(Dispatchers.IO) {
+        lock.withLock {
+            unloadPlugin(id)
+            errors.remove(id)
+            writeState(readState() - id)
+            File(root, id).deleteRecursively()
+            publish()
+        }
+    }
+
+    /** Инструменты всех включённых плагинов. */
+    suspend fun getTools(): List<Tool> {
+        awaitReady()
+        return loaded.values.flatMap { lp ->
+            val tools = runCatching { lp.plugin.tools.orEmpty() }
+                .onFailure { Log.e(TAG, "getTools failed: ${lp.manifest.id}", it) }
+                .getOrDefault(emptyList())
+            tools.mapNotNull { runCatching { toTool(lp.manifest.id, it) }.getOrNull() }
+        }
+    }
+
+    /** Сумма системных промптов всех включённых плагинов. */
+    fun getSystemPrompt(): String = loaded.values.mapNotNull { lp ->
+        runCatching { lp.plugin.systemPrompt }
+            .onFailure { Log.e(TAG, "getSystemPrompt failed: ${lp.manifest.id}", it) }
+            .getOrNull()?.takeIf { it.isNotBlank() }
+    }.joinToString("\n\n")
+
+    fun hasActivePlugins(): Boolean = loaded.isNotEmpty()
+
+    fun transformInput(role: String, text: String): String =
+        loaded.values.fold(text) { acc, lp ->
+            runCatching { lp.plugin.transformInput(role, acc) }
+                .onFailure { Log.e(TAG, "transformInput failed: ${lp.manifest.id}", it) }
+                .getOrNull() ?: acc
+        }
+
+    fun transformOutput(text: String): String =
+        loaded.values.fold(text) { acc, lp ->
+            runCatching { lp.plugin.transformOutput(acc) }
+                .onFailure { Log.e(TAG, "transformOutput failed: ${lp.manifest.id}", it) }
+                .getOrNull() ?: acc
+        }
+
+    // ---------- внутренности ----------
+
+    private fun toTool(pluginId: String, t: PluginTool): Tool {
+        val toolName = "plugin_${pluginId}_${t.name}".replace(Regex("[^A-Za-z0-9_-]"), "_").take(64)
+        val handler = t.handler
+        return Tool(
+            name = toolName,
+            description = t.description.orEmpty(),
+            parameters = {
+                val schema = t.parametersSchema?.takeIf { it.isNotBlank() }
+                    ?.let { runCatching { json.parseToJsonElement(it).jsonObject }.getOrNull() }
+                InputSchema.Obj(
+                    properties = schema?.get("properties")?.jsonObject ?: JsonObject(emptyMap()),
+                    required = schema?.get("required")?.jsonArray?.map { it.jsonPrimitive.content },
+                )
+            },
+            needsApproval = { t.needsApproval },
+            execute = { args ->
+                val result = withContext(Dispatchers.IO) {
+                    try {
+                        handler.execute(args.toString()) ?: ""
+                    } catch (e: Throwable) {
+                        Log.e(TAG, "tool $toolName failed", e)
+                        "Error: ${e.message ?: e.javaClass.simpleName}"
+                    }
+                }
+                listOf(UIMessagePart.Text(result))
+            },
+        )
+    }
+
+    private fun publish() {
+        val enabled = readState().toSet()
+        val infos = root.listFiles()
+            .orEmpty()
+            .filter { it.isDirectory && !it.name.startsWith(".") }
+            .mapNotNull { dir ->
+                val manifest = readManifest(dir) ?: return@mapNotNull null
+                PluginInfo(
+                    manifest = manifest,
+                    enabled = manifest.id in enabled,
+                    loaded = loaded.containsKey(manifest.id),
+                    error = errors[manifest.id],
+                )
+            }
+            .sortedBy { it.manifest.name.lowercase() }
+        _plugins.value = infos
+    }
+
+    private fun readManifest(dir: File): PluginManifest? = runCatching {
+        json.decodeFromString<PluginManifest>(File(dir, "plugin.json").readText())
+    }.getOrNull()
+
+    private fun readState(): List<String> = runCatching {
+        json.decodeFromString<PluginState>(stateFile.readText()).enabled
+    }.getOrDefault(emptyList())
+
+    private fun writeState(enabled: Collection<String>) {
+        stateFile.writeText(json.encodeToString(PluginState(enabled.toList())))
+    }
+
+    /** Если приложение упало во время загрузки плагина — отключаем этот плагин. */
+    private fun recoverFromCrash() {
+        if (!loadingMarker.exists()) return
+        val culprit = runCatching { loadingMarker.readText().trim() }.getOrNull()
+        loadingMarker.delete()
+        if (!culprit.isNullOrEmpty()) {
+            Log.w(TAG, "App crashed while loading plugin $culprit, disabling it")
+            writeState(readState() - culprit)
+            errors[culprit] = "The app crashed while loading this plugin, so it was disabled"
+        }
+    }
+
+    private fun loadPluginSafely(id: String) {
+        if (loaded.containsKey(id)) return
+        val dir = File(root, id)
+        try {
+            loadingMarker.writeText(id)
+            val manifest = readManifest(dir) ?: error("plugin.json is missing or invalid")
+            check(manifest.id == id) { "Plugin id mismatch" }
+            val jar = File(dir, "code.jar")
+            check(jar.exists()) { "code.jar is missing" }
+            // Android 14+: загружаемый код должен быть read-only
+            jar.setReadOnly()
+            val libDir = File(dir, "lib").takeIf { it.isDirectory }?.absolutePath
+            val loader = DexClassLoader(jar.absolutePath, null, libDir, context.classLoader)
+            val plugin = loader.loadClass(manifest.mainClass)
+                .getDeclaredConstructor().newInstance() as RikkaPlugin
+            plugin.onLoad(PluginContextImpl(context.applicationContext as Application, manifest, dir))
+            loaded[id] = LoadedPlugin(manifest, plugin)
+            errors.remove(id)
+        } catch (e: Throwable) {
+            Log.e(TAG, "Failed to load plugin $id", e)
+            errors[id] = (e.cause ?: e).let { "${it.javaClass.simpleName}: ${it.message}" }
+        } finally {
+            loadingMarker.delete()
+        }
+    }
+
+    private fun unloadPlugin(id: String) {
+        val lp = loaded.remove(id) ?: return
+        runCatching { lp.plugin.onUnload() }
+            .onFailure { Log.e(TAG, "onUnload failed: $id", it) }
+    }
+
+    /** Распаковывает zip в [tmp], собирает code.jar из classes*.dex, возвращает манифест. */
+    private fun extractToTemp(uri: Uri, tmp: File): PluginManifest {
+        tmp.mkdirs()
+        val srcZip = File(tmp, "src.zip")
+        context.contentResolver.openInputStream(uri)?.use { input ->
+            srcZip.outputStream().use { out -> input.copyTo(out) }
+        } ?: error("Cannot open file")
+
+        var total = 0L
+        val manifest: PluginManifest
+        ZipFile(srcZip).use { zip ->
+            val entries = zip.entries().asSequence().filter { !it.isDirectory }.toList()
+            val manifestEntry = entries.firstOrNull { it.name == "plugin.json" }
+                ?: entries.filter { it.name.endsWith("/plugin.json") }.minByOrNull { it.name.length }
+                ?: error("plugin.json not found in the archive")
+            val prefix = manifestEntry.name.removeSuffix("plugin.json")
+            manifest = json.decodeFromString<PluginManifest>(
+                zip.getInputStream(manifestEntry).use { it.readBytes().decodeToString() }
+            )
+            require(PLUGIN_ID_REGEX.matches(manifest.id)) { "Invalid plugin id: ${manifest.id}" }
+            require(manifest.mainClass.isNotBlank()) { "mainClass is empty" }
+            require(manifest.minAppVersionCode <= (BuildConfig.VERSION_CODE.toIntOrNull() ?: 0)) {
+                "Plugin requires a newer app version (${manifest.minAppVersionCode})"
+            }
+
+            val abi = Build.SUPPORTED_ABIS.firstOrNull { a ->
+                entries.any { it.name.startsWith("${prefix}lib/$a/") }
+            }
+            var dexCount = 0
+            ZipOutputStream(File(tmp, "code.jar").outputStream().buffered()).use { jarOut ->
+                for (entry in entries) {
+                    if (!entry.name.startsWith(prefix)) continue
+                    val rel = entry.name.removePrefix(prefix).replace('\\', '/')
+                    if (rel == "plugin.json") continue
+                    total += entry.size.coerceAtLeast(0)
+                    require(total <= MAX_PLUGIN_BYTES) { "Plugin is too large" }
+                    when {
+                        DEX_NAME_REGEX.matches(rel) -> {
+                            jarOut.putNextEntry(ZipEntry(rel))
+                            zip.getInputStream(entry).use { it.copyTo(jarOut) }
+                            jarOut.closeEntry()
+                            dexCount++
+                        }
+                        rel.startsWith("lib/") -> {
+                            if (abi != null && rel.startsWith("lib/$abi/")) {
+                                copyEntry(zip, entry, File(tmp, "lib"), rel.removePrefix("lib/$abi/"))
+                            }
+                        }
+                        else -> copyEntry(zip, entry, tmp, "files/$rel")
+                    }
+                }
+            }
+            require(dexCount > 0) { "No classes.dex found in the archive" }
+        }
+        srcZip.delete()
+        File(tmp, "plugin.json").writeText(json.encodeToString(manifest))
+        // Папка плагина доступна ему для записи данных
+        File(tmp, "data").mkdirs()
+        return manifest
+    }
+
+    private fun copyEntry(zip: ZipFile, entry: ZipEntry, baseDir: File, relPath: String) {
+        val out = File(baseDir, relPath).canonicalFile
+        // защита от zip-slip
+        require(out.path.startsWith(baseDir.canonicalPath + File.separator)) { "Bad entry path: $relPath" }
+        out.parentFile?.mkdirs()
+        zip.getInputStream(entry).use { input -> out.outputStream().use { input.copyTo(it) } }
+    }
+}
+
+private class PluginContextImpl(
+    private val app: Application,
+    private val manifest: PluginManifest,
+    private val dir: File,
+) : PluginContext {
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    override fun getApplication(): Application = app
+
+    override fun getPluginId(): String = manifest.id
+
+    override fun getPluginDir(): File = dir
+
+    override fun getPreferences(): SharedPreferences =
+        app.getSharedPreferences("plugin_${manifest.id}", Context.MODE_PRIVATE)
+
+    override fun getHostVersionCode(): Int = BuildConfig.VERSION_CODE.toIntOrNull() ?: 0
+
+    override fun getHostService(className: String): Any? = runCatching {
+        GlobalContext.get().getOrNull<Any>(Class.forName(className).kotlin)
+    }.getOrNull()
+
+    override fun runOnMainThread(runnable: Runnable) {
+        if (Looper.myLooper() == Looper.getMainLooper()) runnable.run() else mainHandler.post(runnable)
+    }
+
+    override fun log(message: String) {
+        Log.i("Plugin/${manifest.id}", message)
+    }
+}
